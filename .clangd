CompileFlags:
  CompilationDatabase: build-release
  Remove:
    - -fanalyzer
    - -Wnoexcept
    - -Wredundant-tags
    - -Wfatal-errors
    - -Werror
    - -fdiagnostics-color
    - -fdiagnostics-urls=always
    - -fdiagnostics-parseable-fixits
    - -fdiagnostics-generate-patch
    - -Wno-error=analyzer-symbol-too-complex
    - -Wno-error=analyzer-too-complex
    - -Wno-error=analyzer-exposure-through-uninit-copy
    - -fmodules-ts
    - -fmodule-mapper=CMakeFiles\TETRIS-ESP32.dir\main.cpp.obj.modmap
    - -fdeps-format=p1689r51
    - -fdeps-format=p1689r5

Diagnostics:
  ClangTidy:
    Add: [cppcoreguidelines-init-variables]

---
If:
  PathMatch: (^|.*[\\/])dependencies[\\/]TFT_eSPI[\\/].*
Diagnostics:
  Suppress: "*"
  